# ==========================================
# Agentic AI Travel Planning Assistant Config
# ==========================================

# Local LLM / Ollama Configuration
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434

# Optional Cloud LLM Fallbacks (if needed)
# GOOGLE_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration (Neon Tech PostgreSQL)
# Example: postgresql://username:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./travel_planner.db

# External APIs
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Application Settings
APP_TITLE=Agentic Travel Planning Assistant
DEFAULT_CURRENCY=INR
REQUEST_TIMEOUT_SECONDS=15
